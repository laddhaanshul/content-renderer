{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "composite": true,
    "incremental": true,
    "outDir": "dist"
  },
  "files": [],
  "include": [],
  "references": [
    {
      "path": "packages/core"
    },
    {
      "path": "packages/react"
    }
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
